@page "/painel"
@inject InventorySnapshotService Inventory

<PageTitle>Visão executiva · Azul Nexus</PageTitle>

@if (_snapshot is null)
{
    <p class="hint">Carregando o inventário…</p>
}
else if (!_snapshot.HasData)
{
    <div class="ph"><div><h1>Visão executiva</h1><p>Ainda não há ativos reconciliados.</p></div></div>
    <div class="card">
        <h3>O que falta para ver o parque aqui</h3>
        <p class="hint">O inventário aparece depois da primeira coleta reconciliada. Confira as fontes e peça uma coleta em Operações.</p>
        <div class="actions"><a class="button primary" href="/operacao">Abrir Operações</a><a class="button" href="/assistente">Abrir o assistente</a></div>
    </div>
}
else
{
    var r = _report!;
    <div class="ph">
        <div><h1>Visão executiva</h1><p>Quantos equipamentos estão efetivamente ativos, quão confiável e recente é essa avaliação e o que investigar primeiro.</p></div>
        <span class="asof">Dados de @r.AsOf.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · coleta, não tempo real</span>
    </div>

    <p class="ctx"><b>@Fmt.Number(r.UniqueAssets)</b> ativos únicos reconciliados · universo avaliado: <b>@Fmt.Number(r.Evaluated)</b> (exclui @Fmt.Number(r.Decommissioned) excluídos ou descomissionados). Um equipamento conhecido por várias ferramentas conta uma vez.
        @if (r.MissingSources.Count > 0) { <span class="pill w"><span aria-hidden="true">▲</span> sem dados de @string.Join(", ", r.MissingSources)</span> }</p>

    <section class="kstrip" aria-label="Indicadores principais">
        @foreach (var k in r.Kpis) { <ExecKpiView Kpi="k" AsOf="r.AsOf" /> }
    </section>

    <div class="grid g2">
        <section class="card">
            <div class="ttl"><h3>Estado dos ativos</h3><a href="/parque-ativo">Detalhar</a></div>
            <p class="sub">Todos os @Fmt.Number(r.UniqueAssets) ativos únicos por estado operacional.</p>
            <Bar Label="Estado operacional" ShowLegend="false" Segments="@StateSegs(r)" />
            <div class="legend vert">
                @foreach (var s in OperationalStates.All)
                {
                    <a href="/inventario?oper=@s" title="@OperationalStates.Explain(s)"><u class="seg @StateCss(s)"></u><span aria-hidden="true">@OperationalStates.Icon(s)</span> @OperationalStates.Title(s) <b>@Fmt.Number(r.States[s])</b></a>
                }
            </div>
        </section>

        <section class="card">
            <div class="ttl"><h3>Fontes de dados</h3><a href="/operacao">Operações</a></div>
            <p class="sub">Quando cada fonte coletou pela última vez. Dados antigos distorcem a classificação.</p>
            <div class="tw wrap" style="border:0"><table style="min-width:0"><thead><tr><th>Fonte</th><th>Situação</th><th>Última coleta</th><th>Registros</th></tr></thead><tbody>
                @foreach (var h in r.Sources)
                {
                    <tr title="@h.Detail"><td class="nm">@h.Label</td><td><span class="pill @SourcePill(h)"><span aria-hidden="true">@SourceIcon(h)</span> @h.Text</span></td><td class="num">@Fmt.Ago(h.LastSuccessAt, r.AsOf)</td><td class="num">@(h.Records is { } n ? Fmt.Number(n) : "—")</td></tr>
                }
            </tbody></table></div>
        </section>
    </div>

    <section class="card">
        <div class="ttl"><h3>Fila de atenção</h3><span class="asof">O que investigar primeiro</span></div>
        <div class="tw" style="border:0"><table style="min-width:0"><thead><tr><th>Motivo</th><th>Situação</th><th class="r">Afetados</th><th>Observação</th><th></th></tr></thead><tbody>
            @foreach (var i in r.Queue)
            {
                <tr>
                    <td class="nm">@i.Reason<small class="sm">@i.Why</small></td>
                    <td><span class="pill @QueuePill(i.Status)"><span aria-hidden="true">@QueueIcon(i.Status)</span> @QueueText(i.Status)</span></td>
                    <td class="num r">@(i.Status is QueueStatus.HasItems or QueueStatus.Zero or QueueStatus.Failed ? Fmt.Number(i.Count) : "—")</td>
                    <td class="note-cell">@i.Note</td>
                    <td>@if (i.Link is not null && i.Status is QueueStatus.HasItems or QueueStatus.Failed){<a class="button" href="@i.Link">Investigar</a>}</td>
                </tr>
            }
        </tbody></table></div>
        <p class="sub" style="margin-top:8px">Zero ocorrências (nada a fazer), sem dados (fonte ainda não coletada), coleta com falha e funcionalidade não disponível são situações diferentes.</p>
    </section>

    <section class="card">
        <div class="ttl"><h3>Governança Microsoft em resumo</h3><a href="/governanca">Abrir a governança</a></div>
        <p class="sub">Registrado, gerenciado, compliant, protegido por MAM e com agente não são a mesma coisa. Cada linha usa a sua própria população.</p>
        <div class="tw" style="border:0"><table style="min-width:0"><thead><tr><th>Conceito</th><th class="r">Quantidade</th><th class="r">Percentual</th><th>População</th></tr></thead><tbody>
            @foreach (var g in r.Governance)
            {
                <tr title="@g.Meaning">
                    <td class="nm">@g.Concept<small class="sm">@g.Meaning</small></td>
                    @if (g.Unavailable is not null)
                    {
                        <td colspan="3"><span class="pill m"><span aria-hidden="true">?</span> @g.Unavailable</span></td>
                    }
                    else
                    {
                        <td class="num r">@(g.Link is null ? Fmt.Number(g.Count) : "")@if (g.Link is not null){<a href="@g.Link">@Fmt.Number(g.Count)</a>}</td>
                        <td class="num r">@(g.Percent is { } p ? Fmt.Pct(p) : "—")</td>
                        <td>@g.Population (@Fmt.Number(g.Denominator))</td>
                    }
                </tr>
            }
        </tbody></table></div>
    </section>
    <p class="note">Tendências ao longo do tempo só aparecem quando houver histórico real e comparável: o Nexus começou a guardar o histórico agora e não preenche semanas anteriores.</p>
}

@code {
    private InventorySnapshot? _snapshot;
    private ExecutiveReport? _report;

    protected override async Task OnInitializedAsync()
    {
        _snapshot = await Inventory.GetAsync();
        if (_snapshot.HasData)
        {
            _report = _snapshot.Executive();
        }
    }

    private static string StateCss(string s) => s switch
    {
        OperationalStates.Confirmed => "s-ok", OperationalStates.Probable => "c-both", OperationalStates.NoRecent => "s-warn", OperationalStates.Conflicting => "s-bad", _ => "c-mute",
    };

    private static IReadOnlyList<Seg> StateSegs(ExecutiveReport r) => OperationalStates.All.Select(s => new Seg(OperationalStates.Title(s), r.States[s], StateCss(s), "/inventario?oper=" + s)).ToList();

    private static string SourcePill(SourceHealth h) => h.Status switch { SourceHealth.Ok => "ok", SourceHealth.Failed => "b", SourceHealth.Late or SourceHealth.Partial => "w", _ => "m" };
    private static string SourceIcon(SourceHealth h) => h.Status switch { SourceHealth.Ok => "✔", SourceHealth.Failed => "✕", SourceHealth.Late or SourceHealth.Partial => "▲", _ => "?" };

    private static string QueuePill(QueueStatus s) => s switch { QueueStatus.HasItems => "w", QueueStatus.Zero => "ok", QueueStatus.Failed => "b", _ => "m" };
    private static string QueueIcon(QueueStatus s) => s switch { QueueStatus.HasItems => "▲", QueueStatus.Zero => "✔", QueueStatus.Failed => "✕", _ => "?" };
    private static string QueueText(QueueStatus s) => s switch { QueueStatus.HasItems => "a investigar", QueueStatus.Zero => "zero ocorrências", QueueStatus.NoData => "sem dados", QueueStatus.Failed => "coleta com falha", _ => "não disponível" };
}
