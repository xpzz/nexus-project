@page "/atividade"
@inject InventorySnapshotService Inventory

<PageTitle>Pool ativo · Azul Nexus</PageTitle>

<div class="ph">
    <div><h1>Pool de máquinas ativas</h1><p>As datas de último report de todas as ferramentas, cruzadas. Uma máquina entra no pool quando uma ferramenta que roda no equipamento reportou dentro da janela, ou quando duas fontes concordam.</p></div>
    @if (_snapshot is not null) { <span class="asof">Janela de @_snapshot.WindowDays dias · dados de @_snapshot.LoadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span> }
</div>

@if (_snapshot is { HasData: true })
{
    var p = _snapshot.Overview().Pool;
    <div class="grid g4">
        <a class="card kcard" href="@Fmt.Inv(atividade: "pool")"><div class="l">Pool ativo</div><div class="v">@Fmt.Number(p.Pool)</div><div class="d">@Fmt.Number(p.Confirmed) confirmadas · @Fmt.Number(p.Single) por uma fonte</div></a>
        <a class="card kcard" href="@Fmt.Inv(atividade: ActivityClasses.Confirmed)"><div class="l">Confirmadas</div><div class="v">@Fmt.Number(p.Confirmed)</div><div class="d">duas ou mais ferramentas reportaram</div></a>
        <a class="card kcard" href="@Fmt.Inv(atividade: ActivityClasses.Unconfirmed)"><div class="l">Não confirmadas</div><div class="v">@Fmt.Number(p.Unconfirmed)</div><div class="d">só AD ou Entra ID viu o equipamento</div></a>
        <a class="card kcard" href="@Fmt.Inv(atividade: ActivityClasses.Inactive)"><div class="l">Inativas</div><div class="v">@Fmt.Number(p.Inactive)</div><div class="d">ninguém reportou em @p.WindowDays dias</div></a>
    </div>

    <section class="card">
        <h3>Como o pool é definido</h3>
        <div class="grid g2" style="margin-top:8px">
            <div>
                <Bar Label="Classes de atividade" Segments="@(new List<Seg>
                {
                    new("Confirmada", p.Confirmed, "s-ok", Fmt.Inv(atividade: ActivityClasses.Confirmed)),
                    new("Uma fonte", p.Single, "c-both", Fmt.Inv(atividade: ActivityClasses.Single)),
                    new("Não confirmada", p.Unconfirmed, "s-warn", Fmt.Inv(atividade: ActivityClasses.Unconfirmed)),
                    new("Inativa", p.Inactive, "c-mute", Fmt.Inv(atividade: ActivityClasses.Inactive)),
                })" />
            </div>
            <div class="list">
                @foreach (var c in new[] { ActivityClasses.Confirmed, ActivityClasses.Single, ActivityClasses.Unconfirmed, ActivityClasses.Inactive })
                {
                    <div class="row" style="padding:5px 0"><div class="t"><b>@ActivityClasses.Title(c)</b><span>@ActivityClasses.Explain(c)</span></div><span class="pill @(c is ActivityClasses.Confirmed or ActivityClasses.Single ? "ok" : c == ActivityClasses.Unconfirmed ? "w" : "m")">@(c is ActivityClasses.Confirmed or ActivityClasses.Single ? "no pool" : "fora do pool")</span></div>
                }
            </div>
        </div>
        <p class="sub" style="margin-top:10px">Ferramentas que rodam no equipamento (SCCM, Intune, Cortex XDR, Netskope, apps protegidos) são evidência forte. O AD (último logon replicado com até duas semanas de atraso) e o Entra ID (login aproximado) são evidência fraca: sozinhos não provam uso.</p>
    </section>

    <section class="card">
        <h3>Cada ferramenta diante do pool</h3>
        <p class="sub">Entre as @Fmt.Number(p.Pool) máquinas do pool: quantas a ferramenta viu dentro da janela, quantas conhece mas estão sem reportar e quantas ela não conhece.</p>
        <div class="tw" style="border:0"><table style="min-width:760px"><thead><tr><th>Ferramenta</th><th>Evidência</th><th>Reportou na janela</th><th>Conhece, sem reportar</th><th>Não conhece</th><th>Cobertura do pool</th></tr></thead><tbody>
            @foreach (var s in p.Sources)
            {
                <tr class="@(s.Enabled ? "" : "off")">
                    <td class="nm">@s.Label</td>
                    <td><span class="pill @(s.Strong ? "a" : "m")">@(s.Strong ? "forte" : "fraca")</span></td>
                    @if (s.Enabled)
                    {
                        <td class="num">@Fmt.Number(s.Reporting)</td><td class="num">@Fmt.Number(s.Silent)</td><td class="num">@Fmt.Number(s.Absent)</td>
                        <td style="min-width:200px"><Bar ShowLegend="false" Label="@("Cobertura de " + s.Label)" Segments="@(new List<Seg> { new("Reportou", s.Reporting, "s-ok"), new("Sem reportar", s.Silent, "s-warn"), new("Não conhece", s.Absent, "c-mute") })" />
                            <small class="asof">@(p.Pool == 0 ? "—" : Fmt.Pct(Math.Round(100.0 * s.Reporting / p.Pool, 1))) do pool</small></td>
                    }
                    else
                    {
                        <td colspan="4"><span class="pill m">Aguardando coleta</span></td>
                    }
                </tr>
            }
        </tbody></table></div>
    </section>

    <div class="grid g2">
        <section class="card">
            <h3>Divergências entre ferramentas</h3>
            <p class="sub">Máquinas do pool em que uma ferramenta está calada e outras reportam.</p>
            <div class="list">
                @foreach (var d in Divergences())
                {
                    <div class="row"><div class="t"><b>@d.Title</b><span>@d.Detail</span></div><div class="r"><strong>@Fmt.Number(d.Count)</strong><a class="button" href="@d.Href">Ver lista</a></div></div>
                }
            </div>
        </section>
        <section class="card">
            <h3>Maior atraso entre as ferramentas</h3>
            <p class="sub">Dispositivos do pool com maior diferença entre a ferramenta mais recente e a mais antiga que os conhece.</p>
            <div class="list">
                @foreach (var x in _widest)
                {
                    <div class="row"><div class="t"><b><a href="/dispositivo/@x.Asset.Id" style="color:inherit">@x.Asset.Name</a></b><span>@Spread(x.Asset)</span></div><span class="pill w">@x.Days dias</span></div>
                }
                @if (_widest.Count == 0) { <div class="row"><span class="pill ok">Nenhuma diferença relevante</span></div> }
            </div>
        </section>
    </div>
}
else if (_snapshot is not null)
{
    <div class="card"><p class="hint">Ainda não há dispositivos reconciliados para calcular o pool.</p></div>
}

@code {
    private InventorySnapshot? _snapshot;
    private List<(Nexus.Data.Entities.Asset Asset, int Days)> _widest = [];

    protected override async Task OnInitializedAsync()
    {
        _snapshot = await Inventory.GetAsync();
        _widest = _snapshot.Views.Where(v => v.Asset.IsActive)
            .Select(v => (v.Asset, Days: Gap(v.Asset)))
            .Where(x => x.Days >= 14).OrderByDescending(x => x.Days).Take(8).ToList();
    }

    private static int Gap(Nexus.Data.Entities.Asset a)
    {
        var seen = ActivityModel.Signals(a).Where(s => s.At is not null && s.Strong).Select(s => s.At!.Value).ToList();
        return seen.Count < 2 ? 0 : (int)(seen.Max() - seen.Min()).TotalDays;
    }

    private static string Spread(Nexus.Data.Entities.Asset a) => string.Join(" · ", ActivityModel.Signals(a).Where(s => s.At is not null && s.Strong).OrderByDescending(s => s.At).Select(s => $"{s.Label} {s.At!.Value.ToLocalTime():dd/MM}"));

    private record Divergence(string Title, string Detail, int Count, string Href);

    private IEnumerable<Divergence> Divergences()
    {
        var pool = _snapshot!.Views.Where(v => v.Asset.IsActive).ToList();
        yield return new("Cliente SCCM mudo, outras ferramentas ativas", "O cliente existe e não reporta; Intune, XDR ou Netskope viram a máquina depois.", pool.Count(v => v.Issues.Contains("stalecomm")), Fmt.Inv(pendencia: "stalecomm"));
        yield return new("Agente XDR parado, máquina ativa", "O agente está desconectado ou sem reportar enquanto outras ferramentas veem o equipamento.", pool.Count(v => v.Issues.Contains("xdroff")), Fmt.Inv(pendencia: "xdroff"));
        yield return new("Só uma ferramenta enxerga a máquina ativa", "Evidência de uma fonte apenas: confirme se o equipamento está em uso.", pool.Count(v => v.Asset.ActivityClass == ActivityClasses.Single), Fmt.Inv(atividade: ActivityClasses.Single));
        yield return new("Ativa no Intune e sem cliente SCCM", "Gerenciada só pela nuvem: confira se isso é esperado para o grupo.", pool.Count(v => v.Asset.InIntune && !v.Asset.SccmClient && v.Group == Groups.Computers && v.Asset.Platform == "WindowsClient"), Fmt.Inv(grupo: "pc", gestao: Management.OnlyIntune));
    }
}
