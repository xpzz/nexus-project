@page "/configuracao/acesso"
@using Nexus.Web.Setup
@inject INexusDbFactory DbFactory
@inject TimeProvider Clock
@inject NavigationManager Navigation

<PageTitle>Acesso à configuração</PageTitle>
<div class="brandhead"><BrandLogo Height="40" /><span>Saúde e inventário do parque</span></div>
<h1>Acesso ao modo de configuração</h1>
<p>Informe o código exibido ao fim da instalação. Ele é de uso único e vale por 24 horas.
   Para gerar outro, no servidor e como administrador: <code>nexusctl setup-code</code>.</p>

<EditForm Model="Input" FormName="setup-code" OnValidSubmit="RedeemAsync" class="card narrow">
    <label for="code">Código de configuração</label>
    <InputText id="code" @bind-Value="Input!.Code" autocomplete="off" placeholder="XXXX-XXXX-XXXX" />
    <button type="submit" class="primary">Entrar</button>
    @if (_error is not null)
    {
        <ErrorBox Error="_error" />
    }
</EditForm>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private CodeInput? Input { get; set; }
    private NexusError? _error;

    protected override void OnInitialized() => Input ??= new();

    private async Task RedeemAsync()
    {
        await using var db = DbFactory.Create();
        var remote = HttpContext.Connection.RemoteIpAddress?.ToString() ?? "desconhecido";
        if (await SetupModeService.RedeemCodeAsync(db, Input?.Code ?? "", remote, Clock, HttpContext.RequestAborted))
        {
            await SetupAccessMiddleware.SignInAsync(HttpContext);
            Navigation.NavigateTo("/assistente", forceLoad: true);
            return;
        }

        _error = ErrorCatalog.SetupCodeInvalid;
    }

    private sealed class CodeInput
    {
        public string? Code { get; set; }
    }
}
