@page "/inventario"
@rendermode InteractiveServer
@inject InventorySnapshotService Inventory
@inject NavigationManager Nav

<PageTitle>Inventário · Azul Nexus</PageTitle>

<div class="ph">
    <div><h1>Inventário completo</h1><p>Um registro por equipamento, com a origem de cada dado. Clique em uma linha para ver todas as fontes lado a lado.</p></div>
    @if (_snapshot is not null) { <span class="asof">@Fmt.Number(_rows.Count) de @Fmt.Number(_snapshot.Views.Count) dispositivos</span> }
</div>

<div class="tools">
    <input type="search" id="q" placeholder="Nome, usuário, serial ou modelo" value="@Q" aria-label="Busca livre" @onchange="e => Go(q: e.Value?.ToString() ?? string.Empty)" />
    <select aria-label="Propriedade" @onchange="e => Go(propriedade: (string?)e.Value)"><option value="">Propriedade</option>@foreach (var o in new[] { "Corporativo", "BYOD", "Externo" }){<option value="@o" selected="@(Propriedade == o)">@o</option>}</select>
    <select aria-label="Grupo" @onchange="e => Go(grupo: (string?)e.Value)"><option value="">Grupo</option>@foreach (var g in Groups.All){<option value="@g" selected="@(Grupo == g)">@Groups.Title(g)</option>}</select>
    <select aria-label="Gestão" @onchange="e => Go(gestao: (string?)e.Value)"><option value="">Gestão</option>@foreach (var m in Management.All.Where(m => m != Management.OnlyMam)){<option value="@m" selected="@(Gestao == m)">@m</option>}</select>
    <select aria-label="Estado" @onchange="e => Go(estado: (string?)e.Value)"><option value="">Estado</option><option value="ativos" selected="@(Estado == "ativos")">Ativos</option>@foreach (var s in States.All){<option value="@s" selected="@(Estado == s)">@s</option>}</select>
    <select aria-label="Pendência" @onchange="e => Go(pendencia: (string?)e.Value)"><option value="">Pendência</option>@foreach (var r in HealthModel.Rules.Where(r => r.Available)){<option value="@r.Id" selected="@(Pendencia == r.Id)">@r.Title</option>}</select>
</div>

@if (Tags().Any())
{
    <div class="tools">
        @foreach (var (label, clear) in Tags())
        {
            <span class="tag">@label<button type="button" aria-label="Remover filtro @label" @onclick="clear">×</button></span>
        }
        <a class="button" href="/inventario">Limpar tudo</a>
    </div>
}

<div class="tw">
    <table>
        <thead>
            <tr>
                @Header("nome", "Dispositivo")@Header("grupo", "Grupo")@Header("usuario", "Usuário")@Header("so", "Sistema")
                <th>Fontes</th>@Header("gestao", "Gestão")@Header("estado", "Estado")@Header("contato", "Contato")@Header("indice", "Índice")
            </tr>
        </thead>
        <tbody>
            @foreach (var v in _page)
            {
                var a = v.Asset;
                <tr class="link" @onclick="() => Open(a.Id)">
                    <td class="nm"><a href="/dispositivo/@a.Id">@a.Name</a><small>@(a.Model ?? a.OperatingSystem ?? "—")</small></td>
                    <td>@Groups.Title(v.Group)<small style="display:block;color:var(--ink3);font-size:11.5px">@InventoryQuery.OwnershipOf(v)</small></td>
                    <td>@(a.PrimaryUser ?? "—")</td>
                    <td>@(a.OperatingSystem ?? a.Platform)</td>
                    <td><span class="ch"><b class="@(a.InSccm ? "on" : "")">SCCM</b><b class="@(a.InIntune ? "on" : "")">INT</b><b class="@(a.InEntra ? "on" : "")">ENT</b><b class="@(a.InAd ? "on" : "")">AD</b></span></td>
                    <td><span class="pill @(v.Management == Management.None ? "b" : v.Management == Management.CoManaged ? "a" : "m")">@v.Management</span></td>
                    <td><span class="pill @Fmt.StateCss(v.State)">@v.State</span></td>
                    <td class="num">@Fmt.Ago(a.LastActivityAt, _now)</td>
                    <td class="score @Fmt.ScoreClass(v.Score)">@v.Score</td>
                </tr>
            }
            @if (_rows.Count == 0)
            {
                <tr><td colspan="9" style="text-align:center;color:var(--ink3);padding:28px">Nenhum dispositivo com esses filtros.</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="pager">
    <span>@(_rows.Count == 0 ? 0 : _skip + 1)–@Math.Min(_rows.Count, _skip + PageSize) de @Fmt.Number(_rows.Count)</span>
    <button type="button" disabled="@(_skip == 0)" @onclick="() => Move(-1)">Anterior</button>
    <button type="button" disabled="@(_skip + PageSize >= _rows.Count)" @onclick="() => Move(1)">Próxima</button>
</div>

@code {
    private const int PageSize = 25;
    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery] public string? Grupo { get; set; }
    [SupplyParameterFromQuery] public string? Gestao { get; set; }
    [SupplyParameterFromQuery] public string? Estado { get; set; }
    [SupplyParameterFromQuery] public string? Pendencia { get; set; }
    [SupplyParameterFromQuery] public string? Propriedade { get; set; }
    [SupplyParameterFromQuery] public string? Funil { get; set; }
    [SupplyParameterFromQuery] public string? Ordem { get; set; }
    [SupplyParameterFromQuery] public bool Desc { get; set; }
    [SupplyParameterFromQuery] public int Pagina { get; set; }

    private InventorySnapshot? _snapshot;
    private List<AssetView> _rows = [];
    private List<AssetView> _page = [];
    private DateTimeOffset _now;
    private int _skip;

    protected override async Task OnParametersSetAsync()
    {
        _snapshot = await Inventory.GetAsync();
        _now = _snapshot.LoadedAt == DateTimeOffset.MinValue ? DateTimeOffset.UtcNow : _snapshot.LoadedAt;
        var filter = new InventoryFilter(Grupo, Gestao, Estado, Pendencia, Propriedade, Funil, Q);
        var sorted = InventoryQuery.Sort(_snapshot.Views.Where(v => InventoryQuery.Matches(v, filter, _now)), Ordem, Desc);
        _rows = sorted.ToList();
        _skip = Math.Clamp(Pagina, 0, Math.Max(0, (_rows.Count - 1) / PageSize)) * PageSize;
        _page = _rows.Skip(_skip).Take(PageSize).ToList();
    }

    private void Go(string? q = null, string? grupo = null, string? gestao = null, string? estado = null, string? pendencia = null, string? propriedade = null)
    {
        Nav.NavigateTo(Fmt.Inv(grupo ?? Grupo, gestao ?? Gestao, estado ?? Estado, pendencia ?? Pendencia, Funil, propriedade ?? Propriedade, q ?? Q));
    }

    // A select left on its placeholder sends an empty value: that clears the filter.
    private void Clear(string which)
    {
        Nav.NavigateTo(Fmt.Inv(which == "grupo" ? null : Grupo, which == "gestao" ? null : Gestao, which == "estado" ? null : Estado, which == "pendencia" ? null : Pendencia,
            which == "funil" ? null : Funil, which == "propriedade" ? null : Propriedade, which == "q" ? null : Q));
    }

    private IEnumerable<(string, Action)> Tags()
    {
        if (!string.IsNullOrEmpty(Q)) yield return ($"Busca: {Q}", () => Clear("q"));
        if (!string.IsNullOrEmpty(Grupo)) yield return ($"Grupo: {(Groups.All.Contains(Grupo) ? Groups.Title(Grupo) : Grupo == "byod" ? "BYOD" : "Sem gestão")}", () => Clear("grupo"));
        if (!string.IsNullOrEmpty(Gestao)) yield return ($"Gestão: {Gestao}", () => Clear("gestao"));
        if (!string.IsNullOrEmpty(Estado)) yield return ($"Estado: {(Estado == "ativos" ? "Ativos" : Estado)}", () => Clear("estado"));
        if (!string.IsNullOrEmpty(Propriedade)) yield return ($"Propriedade: {Propriedade}", () => Clear("propriedade"));
        if (!string.IsNullOrEmpty(Pendencia) && HealthModel.Rules.Any(r => r.Id == Pendencia)) yield return ($"Pendência: {HealthModel.RuleOf(Pendencia).Title}", () => Clear("pendencia"));
        if (!string.IsNullOrEmpty(Funil) && InventoryQuery.FunnelNames.TryGetValue(Funil, out var name)) yield return ($"Funil: {name}", () => Clear("funil"));
    }

    private void Open(Guid id) => Nav.NavigateTo("/dispositivo/" + id);

    private void Move(int delta)
    {
        var page = Math.Max(0, _skip / PageSize + delta);
        Nav.NavigateTo(Nav.GetUriWithQueryParameter("pagina", page));
    }

    private RenderFragment Header(string key, string label) => __builder =>
    {
        var active = (Ordem ?? "indice") == key;
        var desc = active ? !Desc : false;
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?> { ["ordem"] = key, ["desc"] = desc ? "true" : null, ["pagina"] = null });
        <th class="s"><a href="@uri" style="color:inherit;text-decoration:none">@label@(active ? (Desc ? " ↓" : " ↑") : "")</a></th>
    };
}
