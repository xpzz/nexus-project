@page "/inventario"
@inject InventorySnapshotService Inventory
@inject NavigationManager Nav

<PageTitle>Inventário · Azul Nexus</PageTitle>

<div class="ph">
    <div><h1>Inventário completo</h1><p>Um registro por equipamento, com a origem de cada dado. Clique em uma linha para ver todas as fontes lado a lado.</p></div>
    @if (_snapshot is not null) { <span class="asof">@Fmt.Number(_rows.Count) de @Fmt.Number(_snapshot.Views.Count) dispositivos</span> }
</div>

<form method="get" action="/inventario" class="tools">
    <input type="search" name="q" placeholder="Nome, usuário, serial ou modelo" value="@Q" aria-label="Busca livre" />
    <select name="propriedade" aria-label="Propriedade" data-auto><option value="">Propriedade</option>@foreach (var o in new[] { "Corporativo", "BYOD", "Externo" }){<option value="@o" selected="@(Propriedade == o)">@o</option>}</select>
    <select name="grupo" aria-label="Grupo" data-auto><option value="">Grupo</option>@foreach (var g in Groups.All){<option value="@g" selected="@(Grupo == g)">@Groups.Title(g)</option>}<option value="byod" selected="@(Grupo == "byod")">BYOD (celulares e computadores)</option><option value="sem-gestao" selected="@(Grupo == "sem-gestao")">Sem gestão</option></select>
    <select name="gestao" aria-label="Gestão" data-auto><option value="">Gestão</option>@foreach (var m in Management.All.Where(m => m != Management.OnlyMam)){<option value="@m" selected="@(Gestao == m)">@m</option>}</select>
    <select name="estado" aria-label="Estado" data-auto><option value="">Estado</option><option value="ativos" selected="@(Estado == "ativos")">Ativos</option>@foreach (var s in States.All){<option value="@s" selected="@(Estado == s)">@s</option>}</select>
    <select name="pendencia" aria-label="Pendência" data-auto><option value="">Pendência</option>@foreach (var r in HealthModel.Rules.Where(r => r.Available)){<option value="@r.Id" selected="@(Pendencia == r.Id)">@r.Title</option>}</select>
    @if (!string.IsNullOrEmpty(Funil)) { <input type="hidden" name="funil" value="@Funil" /> }
    @if (!string.IsNullOrEmpty(Ordem)) { <input type="hidden" name="ordem" value="@Ordem" /> }
    @if (Desc) { <input type="hidden" name="desc" value="true" /> }
    <button type="submit">Filtrar</button>
</form>

@if (Tags().Any())
{
    <div class="tools">
        @foreach (var (label, href) in Tags())
        {
            <span class="tag">@label<a href="@href" aria-label="Remover filtro @label" style="text-decoration:none;color:inherit;padding:0 6px">×</a></span>
        }
        <a class="button" href="/inventario">Limpar tudo</a>
    </div>
}

<div class="tw">
    <table>
        <thead>
            <tr>
                @Header("nome", "Dispositivo")@Header("grupo", "Grupo")@Header("usuario", "Usuário")@Header("so", "Sistema")
                <th>Fontes</th>@Header("gestao", "Gestão")@Header("estado", "Estado")@Header("contato", "Contato")@Header("indice", "Índice")
            </tr>
        </thead>
        <tbody>
            @foreach (var v in _page)
            {
                var a = v.Asset;
                <tr class="link" data-href="/dispositivo/@a.Id">
                    <td class="nm"><a href="/dispositivo/@a.Id">@a.Name</a><small>@(a.Model ?? a.OperatingSystem ?? "—")</small></td>
                    <td>@Groups.Title(v.Group)<small style="display:block;color:var(--ink3);font-size:11.5px">@InventoryQuery.OwnershipOf(v)</small></td>
                    <td>@(a.PrimaryUser ?? "—")</td>
                    <td>@(a.OperatingSystem ?? a.Platform)</td>
                    <td><span class="ch"><b class="@(a.InSccm ? "on" : "")">SCCM</b><b class="@(a.InIntune ? "on" : "")">INT</b><b class="@(a.InEntra ? "on" : "")">ENT</b><b class="@(a.InAd ? "on" : "")">AD</b></span></td>
                    <td><span class="pill @(v.Management == Management.None ? "b" : v.Management == Management.CoManaged ? "a" : "m")">@v.Management</span></td>
                    <td><span class="pill @Fmt.StateCss(v.State)">@v.State</span></td>
                    <td class="num">@Fmt.Ago(a.LastActivityAt, _now)</td>
                    <td class="score @Fmt.ScoreClass(v.Score)">@v.Score</td>
                </tr>
            }
            @if (_rows.Count == 0)
            {
                <tr><td colspan="9" style="text-align:center;color:var(--ink3);padding:28px">Nenhum dispositivo com esses filtros.</td></tr>
            }
        </tbody>
    </table>
</div>

<div class="pager">
    <span>@(_rows.Count == 0 ? 0 : _skip + 1)–@Math.Min(_rows.Count, _skip + PageSize) de @Fmt.Number(_rows.Count)</span>
    @if (_skip == 0) { <span class="button" style="opacity:.5">Anterior</span> } else { <a class="button" href="@Link(pagina: _skip / PageSize - 1)">Anterior</a> }
    @if (_skip + PageSize >= _rows.Count) { <span class="button" style="opacity:.5">Próxima</span> } else { <a class="button" href="@Link(pagina: _skip / PageSize + 1)">Próxima</a> }
</div>

@code {
    private const int PageSize = 25;
    [SupplyParameterFromQuery] public string? Q { get; set; }
    [SupplyParameterFromQuery] public string? Grupo { get; set; }
    [SupplyParameterFromQuery] public string? Gestao { get; set; }
    [SupplyParameterFromQuery] public string? Estado { get; set; }
    [SupplyParameterFromQuery] public string? Pendencia { get; set; }
    [SupplyParameterFromQuery] public string? Propriedade { get; set; }
    [SupplyParameterFromQuery] public string? Funil { get; set; }
    [SupplyParameterFromQuery] public string? Ordem { get; set; }
    [SupplyParameterFromQuery] public bool Desc { get; set; }
    [SupplyParameterFromQuery] public int Pagina { get; set; }

    private InventorySnapshot? _snapshot;
    private List<AssetView> _rows = [];
    private List<AssetView> _page = [];
    private DateTimeOffset _now;
    private int _skip;

    protected override async Task OnInitializedAsync()
    {
        _snapshot = await Inventory.GetAsync();
        _now = _snapshot.LoadedAt == DateTimeOffset.MinValue ? DateTimeOffset.UtcNow : _snapshot.LoadedAt;
        var filter = new InventoryFilter(Grupo, Gestao, Estado, Pendencia, Propriedade, Funil, Q);
        _rows = InventoryQuery.Sort(_snapshot.Views.Where(v => InventoryQuery.Matches(v, filter, _now)), Ordem, Desc).ToList();
        _skip = Math.Clamp(Pagina, 0, Math.Max(0, (_rows.Count - 1) / PageSize)) * PageSize;
        _page = _rows.Skip(_skip).Take(PageSize).ToList();
    }

    // Every control is a plain link or form field: the page is rendered on the server once and needs no live connection.
    private string Link(string? q = null, string? grupo = null, string? gestao = null, string? estado = null, string? pendencia = null, string? funil = null, string? propriedade = null, string? ordem = null, bool? desc = null, int? pagina = null)
    {
        var parts = new List<string>();
        void Add(string key, string? value) { if (!string.IsNullOrEmpty(value)) parts.Add($"{key}={Uri.EscapeDataString(value)}"); }
        Add("q", q ?? Q); Add("grupo", grupo ?? Grupo); Add("gestao", gestao ?? Gestao); Add("estado", estado ?? Estado); Add("pendencia", pendencia ?? Pendencia);
        Add("funil", funil ?? Funil); Add("propriedade", propriedade ?? Propriedade); Add("ordem", ordem ?? Ordem);
        if (desc ?? Desc) parts.Add("desc=true");
        if (pagina is > 0) parts.Add($"pagina={pagina}");
        return parts.Count == 0 ? "/inventario" : "/inventario?" + string.Join("&", parts);
    }

    private string Without(string which) => which switch
    {
        "q" => Fmt.Inv(Grupo, Gestao, Estado, Pendencia, Funil, Propriedade, null),
        "grupo" => Fmt.Inv(null, Gestao, Estado, Pendencia, Funil, Propriedade, Q),
        "gestao" => Fmt.Inv(Grupo, null, Estado, Pendencia, Funil, Propriedade, Q),
        "estado" => Fmt.Inv(Grupo, Gestao, null, Pendencia, Funil, Propriedade, Q),
        "pendencia" => Fmt.Inv(Grupo, Gestao, Estado, null, Funil, Propriedade, Q),
        "funil" => Fmt.Inv(Grupo, Gestao, Estado, Pendencia, null, Propriedade, Q),
        _ => Fmt.Inv(Grupo, Gestao, Estado, Pendencia, Funil, null, Q),
    };

    private IEnumerable<(string, string)> Tags()
    {
        if (!string.IsNullOrEmpty(Q)) yield return ($"Busca: {Q}", Without("q"));
        if (!string.IsNullOrEmpty(Grupo)) yield return ($"Grupo: {(Groups.All.Contains(Grupo) ? Groups.Title(Grupo) : Grupo == "byod" ? "BYOD" : "Sem gestão")}", Without("grupo"));
        if (!string.IsNullOrEmpty(Gestao)) yield return ($"Gestão: {Gestao}", Without("gestao"));
        if (!string.IsNullOrEmpty(Estado)) yield return ($"Estado: {(Estado == "ativos" ? "Ativos" : Estado)}", Without("estado"));
        if (!string.IsNullOrEmpty(Propriedade)) yield return ($"Propriedade: {Propriedade}", Without("propriedade"));
        if (!string.IsNullOrEmpty(Pendencia) && HealthModel.Rules.Any(r => r.Id == Pendencia)) yield return ($"Pendência: {HealthModel.RuleOf(Pendencia).Title}", Without("pendencia"));
        if (!string.IsNullOrEmpty(Funil) && InventoryQuery.FunnelNames.TryGetValue(Funil, out var name)) yield return ($"Funil: {name}", Without("funil"));
    }

    private RenderFragment Header(string key, string label) => __builder =>
    {
        var active = (Ordem ?? "indice") == key;
        var desc = active && !Desc;
        <th class="s"><a href="@Link(ordem: key, desc: desc)" style="color:inherit;text-decoration:none">@label@(active ? (Desc ? " ↓" : " ↑") : "")</a></th>
    };
}
