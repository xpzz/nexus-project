@page "/pendencias"
@inject InventorySnapshotService Inventory
@inject INexusDbFactory DbFactory

<PageTitle>Pendências · Azul Nexus</PageTitle>

<div class="ph">
    <div><h1>Pendências</h1><p>"Sem SCCM" e "sem Intune" só viram pendência quando contrariam a gestão esperada do grupo. Cada regra abre a lista dos dispositivos afetados.</p></div>
    @if (_snapshot is not null) { <span class="asof">@Fmt.Number(_snapshot.Issues.WithPending) dispositivos com pendência</span> }
</div>

@if (_snapshot is not null)
{
    <div class="grid g4">
        @foreach (var p in Enum.GetValues<Priority>())
        {
            var n = _snapshot.Views.Count(v => v.Issues.Any(i => i != "stale" && HealthModel.RuleOf(i).Priority == p && HealthModel.RuleOf(i).IsAvailable(_snapshot.Sources)));
            <div class="card kcard"><div class="l"><span>@Fmt.PriorityLabel(p)</span><span class="pill @Fmt.PriorityCss(p)">peso @(p switch { Priority.Critical => 40, Priority.High => 20, Priority.Medium => 8, _ => 3 })</span></div><div class="v">@Fmt.Number(n)</div><div class="d">dispositivos afetados</div></div>
        }
    </div>

    <section class="card">
        <h3>Regras ativas</h3><p class="sub">Agrupadas por prioridade. A divisão mostra onde cada pendência se concentra.</p>
        <div class="list">
            @foreach (var r in HealthModel.Rules.Where(r => r.IsAvailable(_snapshot.Sources)).OrderBy(r => r.Priority))
            {
                var total = _snapshot.Issues.Rule(r.Id);
                <div class="row">
                    <div class="t"><b>@r.Title</b><span>@r.Action · responsável sugerido: @r.Owner</span>
                        <div class="legend" style="margin:4px 0 0">@foreach (var g in Groups.All.Where(g => _snapshot.Issues.RuleInGroup(g, r.Id) > 0)){<span>@Groups.Title(g) <b>@_snapshot.Issues.RuleInGroup(g, r.Id)</b></span>}</div></div>
                    <div class="r"><span class="pill @Fmt.PriorityCss(r.Priority)">@Fmt.PriorityLabel(r.Priority)</span><strong>@Fmt.Number(total)</strong><a class="button" href="@Fmt.Inv(pendencia: r.Id)">Ver lista</a></div>
                </div>
            }
        </div>
    </section>

    <div class="grid g2">
        <section class="card">
            <h3>Ocorrências por responsável</h3><p class="sub">Soma de ocorrências das regras ativas, exceto "sem comunicação".</p>
            <div class="list">
                @foreach (var o in HealthModel.Rules.Where(r => r.IsAvailable(_snapshot.Sources) && r.Id != "stale").GroupBy(r => r.Owner).Select(g => (Owner: g.Key, Count: g.Sum(r => _snapshot.Issues.Rule(r.Id)))).OrderByDescending(x => x.Count))
                {
                    <div class="row" style="padding:7px 0"><span>@o.Owner</span><strong style="font:700 16px var(--f-display)">@Fmt.Number(o.Count)</strong></div>
                }
            </div>
        </section>
        <section class="card">
            <h3>Aguardando coleta</h3><p class="sub">Regras que dependem de dados que o Nexus ainda não coleta. Não aparecem como zero.</p>
            <div class="list">
                @foreach (var r in HealthModel.Rules.Where(r => !r.IsAvailable(_snapshot.Sources)))
                {
                    <div class="row" style="padding:7px 0"><div class="t"><b>@r.Title</b><span>@r.WhyUnavailable(_snapshot.Sources)</span></div><span class="pill @Fmt.PriorityCss(r.Priority)">@Fmt.PriorityLabel(r.Priority)</span></div>
                }
            </div>
        </section>
    </div>

    <section class="card">
        <h3>Fila de reconciliação</h3><p class="sub">Casos ambíguos. O Nexus não mescla sozinho e cada registro continua contado à parte.</p>
        <div class="list">
            @foreach (var r in _snapshot.Review)
            {
                <div class="row"><div class="t"><b>@Fmt.ReviewKind(r.Kind)</b><span>@r.Detail</span>
                    <div class="legend" style="margin:4px 0 0">@foreach (var id in AssetsOf(r)){<a href="/dispositivo/@id">@(NameOf(id))</a>}</div></div><span class="pill w">revisar</span></div>
            }
            @if (_snapshot.Review.Count == 0) { <div class="row"><span class="pill ok">Fila vazia</span></div> }
        </div>
    </section>
}

@code {
    private InventorySnapshot? _snapshot;
    private Dictionary<string, Guid> _refs = [];

    protected override async Task OnInitializedAsync()
    {
        _snapshot = await Inventory.GetAsync();
        await using var db = DbFactory.Create();
        _refs = (await db.AssetLinks.AsNoTracking().ToListAsync()).GroupBy(l => $"{l.Source}:{l.SourceKey}").ToDictionary(g => g.Key, g => g.First().AssetId);
    }

    private IEnumerable<Guid> AssetsOf(ReviewItem r) => (r.Sources ?? "").Split(',', StringSplitOptions.RemoveEmptyEntries)
        .Select(s => _refs.TryGetValue(s, out var id) ? (Guid?)id : null).Where(id => id is not null).Select(id => id!.Value).Distinct().Take(6);

    private string NameOf(Guid id) => _snapshot?.Find(id)?.Asset.Name ?? id.ToString("N")[..8];
}
