    {
        "entra-id" or "aad-device-id" => "Entra Device ID",
        "serial" => "serial",
        "hardware-uuid" => "UUID de hardware",
        "name" => "nome (apoio)",
        "user-platform" => "usuário e plataforma",
        "mam-registration" => "registro de MAM",
        "none" => "registro único",
        _ => e,
    };

    private static string FieldLabel(string f) => f switch
    {
        "Created" => "Ativo criado", "Removed" => "Ativo removido", "OperationalState" => "Estado operacional", "AssetType" => "Tipo", "Ownership" => "Propriedade", "Coverage" => "Cobertura de gestão",
        "PrimaryUser" => "Usuário", "Department" => "Área", "OperatingSystem" => "Sistema", "OsVersion" => "Versão do sistema", "IntuneChannel" => "Canal do Intune", "ComplianceState" => "Conformidade",
        "HasMam" => "Proteção de apps", "Confidence" => "Confiança da identidade", "Name" => "Hostname", "Serial" => "Serial", "Model" => "Modelo", _ => f,
    };

    private static string Describe(string field, string? value) => value is null ? "—" : field == "OperationalState" ? OperationalStates.Title(value) : field == "AssetType" ? AssetTypes.Title(value) : value;

    private static string SourceLabel(string s) => s switch { "sccm" => "SCCM", "intune" => "Intune", "xdr" => "Cortex XDR", "netskope" => "Netskope", "mam" => "Proteção de apps (MAM)", "entra" => "Entra ID", "ad" => "Active Directory", _ => s };

    private static MarkupString Yes(bool value) => new(value ? "<span class=\"pill ok\"><span aria-hidden=\"true\">✔</span> sim</span>" : "<span class=\"pill b\"><span aria-hidden=\"true\">✕</span> não</span>");

    private static MarkupString Na(string why) => new($"<span class=\"pill m\"><span aria-hidden=\"true\">?</span> sem evidência ({why})</span>");

    private static bool MamNotApplicable(Asset a) => a.Ownership == "Corporate" && a.Platform is "WindowsClient" or "WindowsServer" && !a.HasMam;

    private static string StatePill(string state) => state switch { "compliant" or "remediated" or "succeeded" => "ok", "nonCompliant" or "error" or "conflict" or "failed" => "b", "pending" => "w", _ => "m" };

    private static string StateLabel(string state) => state switch
    {
        "compliant" => "Conforme", "remediated" => "Remediado", "succeeded" => "Aplicado", "nonCompliant" => "Não conforme", "error" => "Erro", "conflict" => "Conflito",
        "pending" => "Pendente", "notApplicable" => "Não se aplica", "notAssigned" => "Sem atribuição", "failed" => "Falhou", _ => state,
    };

    private static string XdrTypeLabel(string? t) => t switch { "AGENT_TYPE_SERVER" => "Servidor", "AGENT_TYPE_WORKSTATION" => "Estação de trabalho", null => "—", _ => t };

    private static string ChannelLabel(string c) => c switch { "Mdm" => "MDM", "TenantAttach" => "Tenant attach (não é MDM)", "SecurityManagement" => "Defender (não é MDM)", _ => "Outro" };
    private static string TrustLabel(string? t) => t switch { "ServerAd" => "Híbrido", "AzureAd" => "Ingressado", "Workplace" => "Registrado", _ => t ?? "—" };

    private RenderFragment Item(string label, string value) => __builder => { <div><dt>@label</dt><dd style="text-align:left;font-weight:500">@value</dd></div> };

    private RenderFragment SourceCard(string name, bool found, string missing, IEnumerable<(string, string)> rows) => __builder =>
    {
        <div class="sc @(found ? "" : "off")">
            <h4>@name<span class="pill @(found ? "ok" : "m")">@(found ? "encontrado" : "não encontrado")</span></h4>
            @if (found)
            {
                <dl class="kv">@foreach (var (k, v) in rows){<dt>@k</dt><dd>@v</dd>}</dl>
            }
            else
            {
                <span style="font-size:12.5px">@missing</span>
            }
        </div>
    };
}
