@page "/dispositivo/{Id:guid}"
@inject InventorySnapshotService Inventory
@inject INexusDbFactory DbFactory
@inject CurrentAccess Access

<PageTitle>@(_view?.Asset.Name ?? "Dispositivo") · Azul Nexus</PageTitle>

@if (_fetch is { Status: "Pending" })
{
    <HeadContent><meta http-equiv="refresh" content="3" /></HeadContent>
}

@if (_view is null)
{
    <div class="ph"><div><h1>Dispositivo não encontrado</h1><p>Ele pode ter saído do inventário na última reconciliação.</p></div></div>
    <a class="button" href="/inventario">Voltar ao inventário</a>
}
else
{
    var a = _view.Asset;
    var now = _now;
    <div class="ph">
        <div><a href="@BackUrl" class="hint">← Voltar ao inventário</a><h1>@a.Name</h1><p>@(a.Manufacturer) @(a.Model) · @(a.OperatingSystem ?? a.Platform) @(a.OsVersion) · @AssetTypes.Title(a.AssetType) · @InventoryQuery.OwnershipOf(_view)</p></div>
        <span class="asof">Dados de @_now.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · ID Nexus @a.Id</span>
    </div>

    <h2 class="sec">Identidade, atividade e risco são coisas diferentes</h2>
    <div class="grid g3">
        <section class="card tri">
            <div class="l"><span>Confiança da identidade</span><span class="pill @(a.Confidence == "High" ? "ok" : a.Confidence == "Medium" ? "w" : "b")">@(a.Confidence switch { "High" => "Alta", "Medium" => "Média", _ => "Baixa" })</span></div>
            <p class="sub">Quão seguro é que os registros ligados sejam o mesmo equipamento. @(a.NeedsReview ? "Há um conflito a revisar." : "Sem conflito aberto.")</p>
        </section>
        <section class="card tri">
            <div class="l"><span>Atividade</span><span class="pill @OperationalStates.Css(a.OperationalState)"><span aria-hidden="true">@OperationalStates.Icon(a.OperationalState)</span> @OperationalStates.Title(a.OperationalState)</span></div>
            <p class="sub">Score de atividade @a.ActivityScore de 100: chance de o equipamento estar em uso, a partir das datas das fontes.</p>
        </section>
        <section class="card tri">
            <div class="l"><span>Risco de segurança e gestão</span><span class="pill @Fmt.StateCss(_view.State)">@_view.State</span></div>
            <p class="sub">Índice de saúde @_view.Score de 100, das pendências abaixo. Não mede se o equipamento está ativo.</p>
        </section>
    </div>

    <section class="card">
        <h3>Por que esta classificação</h3>
        <p class="explain">@a.ActivityExplanation</p>
        <p class="sub">Limiares do tipo @AssetTypes.Title(a.AssetType): confirmado em até @_th.ConfirmedDays dias, provável em até @_th.ProbableDays, observação até @_th.NoRecentDays, candidato à inativação após @_th.DecommissionDays dias sem relato. @(a.DecommissionCandidate ? "Este equipamento passou do limite." : "")</p>
        <div class="tw" style="border:0"><table style="min-width:620px"><thead><tr><th>Fonte</th><th>Evento</th><th>Quando</th><th>Há</th><th>Peso na decisão</th><th>Natureza</th></tr></thead><tbody>
            @foreach (var r in Reports())
            {
                var sig = r.Signal is null ? null : _signals.FirstOrDefault(x => x.Key == r.Signal.Key);
                <tr><td>@r.Source</td><td>@r.Event</td><td class="num">@(r.At?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</td><td class="num">@Fmt.Ago(r.At, now)</td>
                    <td class="num">@(sig is null ? "—" : sig.Counts ? $"{sig.Probability * 100:0}%" : r.At is null ? "sem data" : "fora das janelas")</td>
                    <td>@(r.Signal is null ? "complementar" : r.Signal.Strong ? "telemetria do equipamento" : "identidade (peso menor)")</td></tr>
            }
        </tbody></table></div>
    </section>

    <h2 class="sec">Identificadores correlacionados</h2>
    <section class="card">
        <div class="tw" style="border:0"><table style="min-width:620px"><thead><tr><th>Identificador</th><th>Valor</th><th>Fonte</th></tr></thead><tbody>
            @foreach (var (kind, value, source) in Identifiers())
            {
                <tr><td>@kind</td><td class="num">@value</td><td>@source</td></tr>
            }
        </tbody></table></div>
        <div class="list" style="margin-top:10px">
            @foreach (var l in _links)
            {
                <div class="row"><div class="t"><b>@Fmt.JobLabel(l.Source == "sccm" ? "sccm.devices" : l.Source == "intune" ? "intune.devices" : l.Source == "entra" ? "entra.devices" : l.Source == "mam" ? "intune.mam" : l.Source == "xdr" ? "xdr.endpoints" : l.Source == "netskope" ? "netskope.clients" : "ad.computers") · @l.SourceKey</b><span>@(l.Reason ?? "Registro de origem do ativo.")</span></div><span class="pill @(l.Confidence == "High" ? "ok" : l.Confidence == "Medium" ? "w" : "m")">vínculo por @EvidenceLabel(l.Evidence) · confiança @(l.Confidence == "High" ? "alta" : l.Confidence == "Medium" ? "média" : "baixa")</span></div>
            }
        </div>
        @foreach (var r in _review) { <div class="note" style="margin-top:10px"><b>@Fmt.ReviewKind(r.Kind):</b> @r.Detail</div> }
    </section>

    <h2 class="sec">Gerenciamento e postura</h2>
    <section class="card">
        <dl class="kv" style="grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px 24px">
            @Item("Gerenciamento", _view.Management)
            @Item("Gestão esperada", Groups.Expected(_view.Group))
            @Item("Cumpre a gestão esperada", _view.MeetsExpected ? "sim" : "não")
            @Item("Usuário", User(a))
            @Item("Último usuário identificado", a.LastUser ?? "—")
            @Item("Área (AD)", a.Department ?? "—")
            @Item("Conta do usuário", a.UserEnabled switch { true => "habilitada", false => "desabilitada", _ => "—" })
        </dl>
    </section>

    <div class="ttl"><h2>Governança Microsoft</h2><span class="asof">Cada conceito é independente dos demais</span></div>
    <section class="card">
        <div class="tw" style="border:0"><table style="min-width:620px"><thead><tr><th>Conceito</th><th>Situação</th><th>Evidência</th></tr></thead><tbody>
            <tr><td>Registrado no Entra ID</td><td>@Yes(a.InEntra)</td><td>@(a.InEntra ? TrustLabel(a.EntraTrustType) : "Sem registro no Entra ID.")</td></tr>
            <tr><td>Gerenciado por MDM</td><td>@Yes(a.IntuneChannel == "Mdm")</td><td>@ChannelLabel(a.IntuneChannel)</td></tr>
            <tr><td>Compliant</td><td>@(a.IntuneChannel != "Mdm" ? Na("sem MDM") : Yes(string.Equals(a.ComplianceState, "compliant", StringComparison.OrdinalIgnoreCase)))</td><td>@(a.ComplianceState ?? "—")</td></tr>
            <tr><td>Protegido por MAM</td><td>@(MamNotApplicable(a) ? Na("MAM é para celulares, tablets e BYOD") : Yes(a.HasMam))</td><td>@(a.HasMam ? $"{a.MamAppCount} registro(s) de app. Protege só os aplicativos compatíveis, não o aparelho." : "Sem registro de proteção de aplicativos.")</td></tr>
            <tr><td>Com agente de segurança</td><td>@(_snapshotSources.Xdr || a.InXdr ? Yes(a.InXdr && Reconciler.IsXdrConnected(a.XdrStatus)) : Na("fonte sem coleta"))</td><td>@(a.InXdr ? a.XdrStatus : "—")</td></tr>
            <tr><td>Acesso permitido por Acesso Condicional</td><td>@Na("não coletado")</td><td>A coleta de Acesso Condicional e de sign-ins ainda não está habilitada.</td></tr>
            <tr><td>Ativo no parque</td><td>@Yes(a.IsActive)</td><td>@OperationalStates.Title(a.OperationalState)</td></tr>
        </tbody></table></div>
    </section>

    <div class="ttl"><h2>Hardware e sistema</h2></div>
    <div class="grid g3">
        <section class="card">
            <h3>Equipamento</h3>
            <dl class="kv" style="margin-top:8px">
                <dt>Processador</dt><dd>@(a.CpuName ?? "—")</dd>
                <dt>Memória</dt><dd>@(a.MemoryMb is { } mem ? $"{mem / 1024.0:0.#} GB" : "—")</dd>
                <dt>BIOS</dt><dd>@(_sccm?.BiosVersion ?? "—")</dd>
                <dt>Fabricante / modelo</dt><dd>@($"{a.Manufacturer} {a.Model}".Trim())</dd>
            </dl>
        </section>
        <section class="card">
            <h3>Disco do sistema</h3>
            @if (a.DiskTotalMb is > 0)
            {
                var used = 100.0 - 100.0 * (a.DiskFreeMb ?? 0) / a.DiskTotalMb.Value;
                <p class="sub">@($"{(a.DiskFreeMb ?? 0) / 1024.0:0.#} GB livres de {a.DiskTotalMb / 1024.0:0.#} GB")</p>
                <div class="meter"><i class="@(used >= 90 ? "bad" : used >= 80 ? "warn" : "")" style="width:@(Math.Round(used).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></i></div>
                <p class="sub" style="margin-top:6px">@($"{used:0}% em uso")</p>
            }
            else
            {
                <p class="sub">Sem dado de disco nas fontes coletadas.</p>
            }
            <dl class="kv"><dt>Criptografia (Intune)</dt><dd>@(a.IsEncrypted switch { true => "ligada", false => "desligada", _ => "—" })</dd></dl>
        </section>
        <section class="card">
            <h3>Sistema operacional</h3>
            <dl class="kv" style="margin-top:8px">
                <dt>Sistema</dt><dd>@(a.OperatingSystem ?? a.Platform)</dd>
                <dt>Versão</dt><dd>@(a.OsVersion ?? "—")</dd>
                <dt>Último boot</dt><dd>@(_sccm?.LastBootAt is { } boot ? Fmt.Ago(boot, now) : "—")</dd>
                <dt>Suporte</dt><dd>@(a.Platform == "WindowsClient" ? (HealthModel.IsWindows10(a) ? "Windows 10 fora de suporte" : "suportado") : "—")</dd>
            </dl>
        </section>
    </div>

    <div class="ttl"><h2>Encontrado em</h2></div>
    <div class="srcs">
        @SourceCard("SCCM", _sccm is not null, "Sem registro no SCCM." + (_view.Group is Groups.Computers or Groups.Servers && a.Platform != "macOS" ? " Esperado para este grupo." : " Este grupo não usa SCCM."),
            _sccm is null ? [] : [("Cliente", _sccm.Client == true ? "instalado" : "sem cliente"), ("Versão do cliente", _sccm.ClientVersion ?? "—"), ("Saúde", a.SccmHealth), ("Último usuário", _sccm.LastLogonUser ?? "—"), ("Site do AD", _sccm.AdSite ?? "—")])
        @SourceCard("Intune", _intune is not null, a.Ownership == "Personal" ? "Sem enrollment MDM. A proteção por MAM aparece abaixo." : "Sem registro no Intune.",
            _intune is null ? [] : [("Canal", ChannelLabel(a.IntuneChannel)), ("Agente", _intune.ManagementAgent ?? "—"), ("Conformidade", _intune.ComplianceState ?? "—"), ("Carência até", _intune.ComplianceGraceExpiresAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—"), ("Propriedade", _intune.OwnerType ?? "—"), ("Tipo de inscrição", _intune.EnrollmentType ?? "—"), ("Autopilot", _intune.AutopilotEnrolled switch { true => "sim", false => "não", _ => "—" }), ("Supervisionado", _intune.IsSupervised switch { true => "sim", false => "não", _ => "—" }), ("Registrado em", _intune.EnrolledAt?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")])
        @SourceCard("Entra ID", _entra is not null, "Sem registro no Entra ID.",
            _entra is null ? [] : [("Associação", TrustLabel(_entra.TrustType)), ("Conta habilitada", _entra.AccountEnabled == false ? "não" : "sim"), ("Propriedade", _entra.Ownership ?? "—")])
        @if (_snapshotSources.Xdr || a.InXdr)
        {
            @SourceCard("Cortex XDR", a.InXdr, "Sem agente do Cortex XDR nesta máquina." + (a.Ownership == "Corporate" && a.Platform is "WindowsClient" or "WindowsServer" ? " Esperado para Windows corporativo." : ""),
                [("Status do agente", a.XdrStatus ?? "—"), ("Status operacional", a.XdrOperationalStatus ?? "—"), ("Tipo", XdrTypeLabel(a.XdrAgentType)), ("IP", a.XdrIp ?? "—"), ("Último contato", Fmt.Ago(a.XdrLastSeenAt, now)), ("Vínculo", a.XdrByNameOnly ? "só pelo nome (baixa confiança)" : "forte")])
        }
        @if (_snapshotSources.Netskope || a.InNetskope)
        {
            @SourceCard("Netskope", a.InNetskope, "Sem cliente Netskope nesta máquina." + (a.Ownership == "Corporate" && a.Platform is "WindowsClient" or "macOS" ? " Esperado para computador corporativo." : ""),
                [("Status do cliente", a.NetskopeStatus ?? "—"), ("Versão", a.NetskopeVersion ?? "—"), ("Último evento", Fmt.Ago(a.NetskopeLastSeenAt, now)), ("Vínculo", a.NetskopeByNameOnly ? "só pelo nome (baixa confiança)" : "forte")])
        }
        @SourceCard("Active Directory", _ad is not null, "Sem objeto no AD.",
            _ad is null ? [] : [("Conta do computador", _ad.Enabled ? "habilitada" : "desabilitada"), ("Vínculo", a.AdByNameOnly ? "só pelo nome (baixa confiança)" : "forte"), ("Caminho", _ad.DistinguishedName)])
    </div>

    <div class="ttl" id="politicas"><h2>Políticas e perfis aplicados</h2>
        <span class="asof">@(a.PoliciesCollected ? $"{a.CompliancePolicies} de conformidade · {a.ConfigProfiles} de configuração · {a.CompliancePoliciesFailed + a.ConfigProfilesFailed} com falha" : "")</span></div>
    <section class="card">
        @if (_intune is null)
        {
            <p class="hint">Este dispositivo não está no Intune; não há políticas de MDM aplicadas.</p>
        }
        else if (!a.PoliciesCollected)
        {
            <p class="hint">As políticas do Intune ainda não foram coletadas (job intune.policies roda a cada 4 horas).</p>
        }
        else if (_states.Count == 0)
        {
            <p class="hint">O Intune não reporta nenhuma política ou perfil para este dispositivo.</p>
        }
        else
        {
            <div class="tw" style="border:0"><table style="min-width:640px"><thead><tr><th>Política ou perfil</th><th>Tipo</th><th>Estado</th><th>Plataforma</th><th>Atribuição</th></tr></thead><tbody>
                @foreach (var st in _states.OrderBy(x => Reconciler.IsFailed(x.State) ? 0 : 1).ThenBy(x => x.Kind).ThenBy(x => x.PolicyName))
                {
                    <tr>
                        <td class="nm"><a href="/intune/politica?tipo=@st.Kind&nome=@Uri.EscapeDataString(st.PolicyName)">@st.PolicyName</a></td>
                        <td>@(st.Kind == "compliance" ? "Conformidade" : "Configuração")</td>
                        <td><span class="pill @StatePill(st.State)">@StateLabel(st.State)</span></td>
                        <td>@(st.Platform ?? "—")</td>
                        <td style="white-space:normal;max-width:300px;color:var(--ink3);font-size:12px">@(_catalog.GetValueOrDefault((st.Kind, st.PolicyName))?.Assignments ?? "—")</td>
                    </tr>
                }
            </tbody></table></div>
        }
    </section>

    @if (_mam.Count > 0 || a.HasMam || _view.Group is Groups.ByodMobile or Groups.ByodComputers)
    {
        <div class="ttl" id="mam"><h2>Proteção de aplicativos (MAM)</h2><span class="asof">@(a.MamLastSyncAt is { } ms ? "última sincronização " + Fmt.Ago(ms, now) : "")</span></div>
        <section class="card">
            @if (_mam.Count == 0)
            {
                <p class="hint">@(_snapshotSources.Mam ? "Nenhum aplicativo protegido por política de MAM foi registrado para este dispositivo." : "A proteção de aplicativos ainda não foi coletada (job intune.mam).")</p>
            }
            else
            {
                <p class="sub">Políticas aplicadas: @(a.MamPolicies ?? "—")</p>
                <div class="tw" style="border:0"><table style="min-width:720px"><thead><tr><th>Aplicativo</th><th>Versão</th><th>Plataforma</th><th>Última sincronização</th><th>Políticas aplicadas</th><th>Alertas</th></tr></thead><tbody>
                    @foreach (var r in _mam.OrderByDescending(r => r.LastSyncAt))
                    {
                        <tr><td class="nm">@(r.AppIdentifier ?? "—")</td><td>@(r.AppVersion ?? "—")</td><td>@(r.DeviceType ?? "—") @(r.PlatformVersion)</td><td class="num">@Fmt.Ago(r.LastSyncAt, now)</td><td style="white-space:normal;color:var(--ink3);font-size:12px">@(r.AppliedPolicies ?? "—")</td><td>@if (!string.IsNullOrEmpty(r.FlaggedReasons)) {<span class="pill w">@r.FlaggedReasons</span>} else {<span class="pill ok">nenhum</span>}</td></tr>
                    }
                </tbody></table></div>
            }
        </section>
    }

    <div class="ttl" id="software"><h2>Software instalado</h2>
        <form method="post" action="/dispositivo/@a.Id/inventario"><button type="submit" class="primary" disabled="@(_fetch is { Status: "Pending" } || (_sccm is null && _intune is null))">@(_fetch is { Status: "Pending" } ? "Coletando…" : _fetch is null ? "Coletar inventário de software" : "Atualizar inventário de software")</button></form></div>
    <section class="card">
        @if (_fetch is null)
        {
            <p class="hint">O inventário de software é grande demais para coletar de todo o parque. Ele é lido sob demanda do SCCM (Adicionar ou remover programas) e do Intune (aplicativos detectados) quando você pede aqui.</p>
        }
        else if (_fetch.Status == "Pending")
        {
            <p class="hint">Pedido enviado ao Worker em @_fetch.RequestedAt.ToLocalTime().ToString("HH:mm:ss"). Esta página se atualiza sozinha.</p>
        }
        else
        {
            <p class="sub">@(_fetch.Status == "Done" ? "Lido" : "Falhou") @Fmt.Ago(_fetch.FetchedAt, now) · @_software.Count programas@(string.IsNullOrEmpty(_fetch.Message) ? "" : " · " + _fetch.Message)</p>
            <form method="get" action="/dispositivo/@a.Id" class="tools" style="margin-bottom:10px"><input type="search" name="sw" value="@Sw" placeholder="Filtrar programa ou fabricante" aria-label="Filtrar software" /><button type="submit">Filtrar</button></form>
            <div class="tw" style="border:0"><table style="min-width:640px"><thead><tr><th>Programa</th><th>Versão</th><th>Fabricante</th><th>Instalado em</th><th>Fonte</th></tr></thead><tbody>
                @foreach (var sw in _shownSoftware)
                {
                    <tr><td class="nm">@sw.Name</td><td>@(sw.Version ?? "—")</td><td>@(sw.Publisher ?? "—")</td><td class="num">@(sw.InstalledOn?.ToLocalTime().ToString("dd/MM/yyyy") ?? "—")</td><td>@(sw.Source == "sccm" ? "SCCM" : "Intune")</td></tr>
                }
            </tbody></table></div>
            @if (_software.Count > _shownSoftware.Count) { <p class="hint">Mostrando @_shownSoftware.Count de @_software.Count. Use o filtro.</p> }
        }
    </section>

    <div class="ttl"><h2>Pendências</h2></div>
    <section class="card">
        <div class="list">
            @foreach (var id in _view.Issues)
            {
                var r = HealthModel.RuleOf(id);
                <div class="row"><div class="t"><b>@r.Title</b><span>@r.Action · responsável sugerido: @r.Owner</span></div><span class="pill @Fmt.PriorityCss(r.Priority)">@Fmt.PriorityLabel(r.Priority)</span></div>
            }
            @if (_view.Issues.Count == 0) { <div class="row"><span class="pill ok">Nenhuma pendência</span></div> }
        </div>
    </section>

    <div class="ttl"><h2>Histórico de alterações</h2><span class="asof">Mudanças relevantes entre reconciliações</span></div>
    <section class="card">
        @if (_changes.Count == 0)
        {
            <p class="hint">Nenhuma alteração registrada para este equipamento desde que o histórico começou.</p>
        }
        else
        {
            <div class="tw" style="border:0"><table style="min-width:560px"><thead><tr><th>Quando</th><th>Campo</th><th>De</th><th>Para</th></tr></thead><tbody>
                @foreach (var c in _changes)
                {
                    <tr><td class="num">@c.At.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@FieldLabel(c.Field)</td><td>@(Describe(c.Field, c.OldValue))</td><td>@(Describe(c.Field, c.NewValue))</td></tr>
                }
            </tbody></table></div>
        }
    </section>

    <div class="ttl"><h2>Linha do tempo das evidências</h2><span class="asof">Cada vez que uma fonte informou uma data nova</span></div>
    <section class="card">
        @if (_timeline.Count == 0)
        {
            <p class="hint">A linha do tempo começa na primeira reconciliação depois da atualização do Nexus.</p>
        }
        else
        {
            <div class="tw" style="border:0"><table style="min-width:480px"><thead><tr><th>Fonte</th><th>Data informada pela fonte</th><th>Coletada em</th></tr></thead><tbody>
                @foreach (var e in _timeline)
                {
                    <tr><td>@SourceLabel(e.Source)</td><td class="num">@e.ObservedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td class="num">@e.CollectedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td></tr>
                }
            </tbody></table></div>
        }
    </section>
    <div class="note">Somente leitura. Dados pessoais em BYOD: o Nexus não coleta telefone, IMEI nem localização.</div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] public string? Sw { get; set; }
    [SupplyParameterFromQuery] public string? Voltar { get; set; }

    /// <summary>Only a path inside the inventory is accepted: the parameter must not become an open redirect.</summary>
    private string BackUrl => Voltar is { Length: > 0 and < 1500 } v && v.StartsWith("/inventario", StringComparison.Ordinal) && !v.StartsWith("//", StringComparison.Ordinal) ? v : "/inventario";
    private AssetView? _view;
    private DateTimeOffset _now;
    private SourceAvailability _snapshotSources = SourceAvailability.All;
    private List<AssetLink> _links = [];
    private List<ReviewItem> _review = [];
    private SccmDeviceRecord? _sccm;
    private IntuneDeviceRecord? _intune;
    private EntraDeviceRecord? _entra;
    private AdComputerRecord? _ad;
    private List<IntuneDevicePolicyState> _states = [];
    private Dictionary<(string, string), IntunePolicyRecord> _catalog = [];
    private List<MamRegistrationRecord> _mam = [];
    private List<InstalledSoftwareRecord> _software = [];
    private List<InstalledSoftwareRecord> _shownSoftware = [];
    private InventoryFetch? _fetch;
    private List<AssetChange> _changes = [];
    private List<EvidenceTimelineEntry> _timeline = [];
    private IReadOnlyList<EvidenceSignal> _signals = [];
    private EvidenceThresholds _th = new();

    protected override async Task OnInitializedAsync()
    {
        var snapshot = await Inventory.GetAsync();
        _now = snapshot.LoadedAt;
        _snapshotSources = snapshot.Sources;
        _windowDays = snapshot.WindowDays;
        _view = snapshot.Find(Id);
        if (_view is null)
        {
            return;
        }

        _th = snapshot.Evidence.For(_view.Asset.AssetType);
        _signals = EvidenceEngine.Signals(_view.Asset, snapshot.LoadedAt, _th, snapshot.Evidence);

        await using var db = DbFactory.Create();
        _links = await db.AssetLinks.AsNoTracking().Where(l => l.AssetId == Id).OrderBy(l => l.Source).ToListAsync();
        string? Key(string source) => _links.FirstOrDefault(l => l.Source == source)?.SourceKey;
        _sccm = int.TryParse(Key("sccm"), out var rid) ? await db.SccmDevices.AsNoTracking().FirstOrDefaultAsync(r => r.ResourceId == rid) : null;
        var iid = Key("intune");
        _intune = iid is null ? null : await db.IntuneDevices.AsNoTracking().FirstOrDefaultAsync(r => r.Id == iid);
        var eid = Key("entra");
        _entra = eid is null ? null : await db.EntraDevices.AsNoTracking().FirstOrDefaultAsync(r => r.Id == eid);
        _ad = Guid.TryParse(Key("ad"), out var gid) ? await db.AdComputers.AsNoTracking().FirstOrDefaultAsync(r => r.ObjectGuid == gid) : null;
        var refs = _links.Select(l => $"{l.Source}:{l.SourceKey}").ToHashSet();
        _review = (await db.ReviewItems.AsNoTracking().ToListAsync()).Where(r => (r.Sources ?? "").Split(',').Any(refs.Contains)).ToList();

        if (iid is not null)
        {
            _states = await db.IntuneDevicePolicyStates.AsNoTracking().Where(s => s.IntuneDeviceId == iid).ToListAsync();
            var names = _states.Select(s => s.PolicyName).Distinct().ToList();
            _catalog = (await db.IntunePolicies.AsNoTracking().Where(p => names.Contains(p.Name)).ToListAsync())
                .GroupBy(p => (p.Kind, p.Name)).ToDictionary(g => g.Key, g => g.First());
        }

        if (Key("mam") is { } mamKey)
        {
            var regs = db.MamRegistrations.AsNoTracking();
            if (mamKey.Contains('|'))
            {
                var parts = mamKey.Split('|');
                _mam = await regs.Where(r => r.UserId == parts[0] && r.DeviceType == parts[1]).ToListAsync();
            }
            else
            {
                var tag = mamKey.StartsWith("tag:", StringComparison.Ordinal) ? mamKey[4..] : mamKey;
                _mam = await regs.Where(r => r.DeviceTag == tag || r.DeviceName == tag).ToListAsync();
            }
        }

        try
        {
            _changes = (await db.AssetChanges.AsNoTracking().Where(c => c.AssetId == Id).ToListAsync()).OrderByDescending(c => c.At).Take(50).ToList();
            _timeline = (await db.EvidenceTimeline.AsNoTracking().Where(e => e.AssetId == Id).ToListAsync()).OrderByDescending(e => e.ObservedAt).Take(60).ToList();
        }
        catch (Exception)
        {
            // History tables arrive with a migration; the device page must still open while it is pending.
        }

        _fetch = await db.InventoryFetches.AsNoTracking().FirstOrDefaultAsync(f => f.AssetId == Id);
        _software = await db.InstalledSoftware.AsNoTracking().Where(s => s.AssetId == Id).OrderBy(s => s.Name).ToListAsync();
        _shownSoftware = string.IsNullOrWhiteSpace(Sw)
            ? _software.Take(200).ToList()
            : _software.Where(s => s.Name.Contains(Sw, StringComparison.OrdinalIgnoreCase) || (s.Publisher ?? "").Contains(Sw, StringComparison.OrdinalIgnoreCase)).Take(200).ToList();
    }

    private record Report(string Source, string Event, DateTimeOffset? At, ActivitySignal? Signal = null);
    private int _windowDays = 30;

    private IEnumerable<Report> Reports()
    {
        var a = _view!.Asset;
        var signals = ActivityModel.Signals(a).ToDictionary(x => x.Key);
        if (a.InSccm)
        {
            yield return new("SCCM", "Atividade do cliente", a.SccmLastSeenAt, signals["sccm"]);
            yield return new("SCCM", "Última solicitação de política", a.SccmLastPolicyAt);
            yield return new("SCCM", "Inventário de hardware", a.SccmLastHwScanAt);
            yield return new("SCCM", "Inventário de software", _sccm?.LastSwScanAt);
            yield return new("SCCM", "Heartbeat (DDR)", _sccm?.LastDdrAt);
        }

        if (a.InIntune) yield return new("Intune", "Última sincronização", a.IntuneLastSyncAt, signals["intune"]);
        if (a.InXdr) yield return new("Cortex XDR", "Último contato do agente", a.XdrLastSeenAt, signals["xdr"]);
        if (a.InNetskope) yield return new("Netskope", "Último evento do cliente", a.NetskopeLastSeenAt, signals["netskope"]);
        if (a.HasMam) yield return new("Intune MAM", "Última sincronização de app", a.MamLastSyncAt, signals["mam"]);
        if (a.InEntra) yield return new("Entra ID", "Último login", a.EntraLastSignInAt, signals["entra"]);
        if (a.InAd) yield return new("Active Directory", "Último logon", a.AdLastLogonAt, signals["ad"]);
    }

    private string User(Asset a) => a.PrimaryUser is null ? "—" : a.Ownership == "Personal" && !Access.CanSeePersonalData ? PersonalData.Mask(a.PrimaryUser) : a.PrimaryUser;

    private IEnumerable<(string Kind, string Value, string Source)> Identifiers()
    {
        var a = _view!.Asset;
        string? Key(string source) => _links.FirstOrDefault(l => l.Source == source)?.SourceKey;
        yield return ("ID interno do Nexus", a.Id.ToString(), "Nexus (imutável enquanto algum vínculo permanecer)");
        yield return ("Serial", a.Serial ?? "sem serial válido", a.Serial is null ? "—" : "SCCM, Intune ou Netskope");
        if (_entra?.DeviceId is { } did) yield return ("Entra Device ID", did.ToString(), "Entra ID");
        if (Key("entra") is { } oid) yield return ("Entra object ID", oid, "Entra ID");
        if (Key("intune") is { } iid) yield return ("Intune managed device ID", iid, "Intune");
        if (Key("sccm") is { } rid) yield return ("SCCM Resource ID", rid, "SCCM");
        if (a.Uuid is not null) yield return ("UUID de hardware (BIOS)", a.Uuid, "SCCM");
        if (Key("ad") is { } g) yield return ("AD objectGUID", g, "Active Directory");
        if (Key("xdr") is { } x) yield return ("Cortex XDR agent ID", x, "Cortex XDR");
        if (Key("netskope") is { } n) yield return ("Netskope client ID", n, "Netskope");
        yield return ("Hostname", a.Name, "fontes de gerenciamento");
        if (a.Fqdn is not null) yield return ("FQDN", a.Fqdn, "AD ou SCCM");
        if (a.IpAddresses is not null) yield return ("IPs conhecidos", a.IpAddresses, "Cortex XDR");
        yield return ("MACs conhecidos", a.MacAddresses ?? "ainda não coletados", a.MacAddresses is null ? "—" : "SCCM ou Intune");
        yield return ("Usuário principal", User(a), "Intune");
    }

