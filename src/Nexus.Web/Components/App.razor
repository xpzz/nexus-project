<!DOCTYPE html>
<html lang="pt-BR" data-theme="@ThemeAttribute" data-theme-pref="@ThemePreference">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <title>Azul Nexus</title>
    <script src="@Assets["theme.js"]"></script>
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="@Assets["app.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string ThemePreference => HttpContext?.Request.Cookies["nexus-theme"] is "light" or "dark" ? HttpContext.Request.Cookies["nexus-theme"]! : "system";

    /// <summary>Explicit choices are rendered by the server so the first paint is right; "system" leaves the attribute off and lets CSS follow the OS.</summary>
    private string? ThemeAttribute => ThemePreference == "system" ? null : ThemePreference;
}
