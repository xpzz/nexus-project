<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <title>Azul Nexus</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Sora:wght@600;700&display=swap" />
    <script>try{var t=localStorage.getItem('nexus-theme');if(t)document.documentElement.setAttribute('data-theme',t)}catch(e){}</script>
    <HeadOutlet />
</head>
<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script>
        document.addEventListener('click', function (e) {
            if (!e.target.closest('#theme')) return;
            var r = document.documentElement, d = r.getAttribute('data-theme');
            var dark = d ? d === 'dark' : matchMedia('(prefers-color-scheme:dark)').matches;
            var next = dark ? 'light' : 'dark';
            r.setAttribute('data-theme', next);
            try { localStorage.setItem('nexus-theme', next); } catch (err) { }
        });
    </script>
</body>
</html>
