@inherits LayoutComponentBase
@inject InventorySnapshotService Inventory
@inject TimeProvider Clock

<div class="app">
    <aside class="side">
        <a class="brand" href="/painel"><div class="logo">N</div><div><b>Azul Nexus</b><span>Saúde e inventário do parque</span></div></a>
        <nav class="nav" aria-label="Principal">
            <h6>Painel</h6>
            <NavLink href="/painel" Match="NavLinkMatch.All">Visão geral</NavLink>
            <h6>Parque</h6>
            <NavLink href="/parque/computadores">Computadores<i>@Count(Groups.Computers)</i></NavLink>
            <NavLink href="/parque/servidores">Servidores<i>@Count(Groups.Servers)</i></NavLink>
            <NavLink href="/parque/celulares">Celulares corp.<i>@Count(Groups.CorpMobile)</i></NavLink>
            <NavLink href="/byod">BYOD<i>@(Count(Groups.ByodMobile) + Count(Groups.ByodComputers))</i></NavLink>
            <NavLink href="/parque/externos">Externos<i>@Count(Groups.External)</i></NavLink>
            <NavLink href="/parque/sem-gestao">Sem gestão<i>@_snapshot.Issues.Rule("nomgr")</i></NavLink>
            <NavLink href="/inventario" Match="NavLinkMatch.All">Inventário completo<i>@_snapshot.Views.Count</i></NavLink>
            <h6>Operação</h6>
            <NavLink href="/operacao">SCCM e Intune</NavLink>
            <NavLink href="/intune">Políticas e MAM<i>@_snapshot.Intune.Policies</i></NavLink>
            <NavLink href="/pendencias">Pendências<i>@_snapshot.Issues.WithPending</i></NavLink>
            <h6>Configuração</h6>
            <NavLink href="/assistente">Assistente</NavLink>
            <NavLink href="/saude">Saúde do Nexus</NavLink>
        </nav>
        <div class="sidefoot">Somente leitura. Nenhuma ação é executada nas ferramentas de origem.</div>
    </aside>
    <div class="main">
        <header class="top">
            <form class="search" method="get" action="/inventario" role="search">
                <span aria-hidden="true">⌕</span>
                <input name="q" type="search" placeholder="Buscar por nome, usuário, serial ou modelo" aria-label="Busca global" />
            </form>
            <div class="chips">
                @foreach (var chip in Chips())
                {
                    <a class="src" href="/operacao" title="@chip.Detail"><i class="dot @chip.Dot"></i>@chip.Name · @chip.Text</a>
                }
            </div>
            <button type="button" id="theme">Tema</button>
        </header>
        <main class="page">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    Ocorreu um erro inesperado. <a href="" class="reload">Recarregar</a>
</div>

@code {
    private InventorySnapshot _snapshot = InventorySnapshot.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _snapshot = await Inventory.GetAsync();
        }
        catch (Exception)
        {
            _snapshot = InventorySnapshot.Empty; // setup screens must still open when the inventory cannot be read
        }
    }

    private int Count(string group) => _snapshot.Issues.Group(group);

    private static readonly (string Name, string[] Jobs)[] SourceGroups =
    [
        ("SCCM", ["sccm.devices"]),
        ("Active Directory", ["ad.computers"]),
        ("Intune", ["intune.devices", "intune.policies", "intune.mam"]),
        ("Entra ID", ["entra.devices", "entra.users"]),
        ("Cortex XDR", ["xdr.endpoints"]),
    ];

    /// <summary>One chip per source: the worst of its collections decides the color; the oldest success decides the age.</summary>
    private IEnumerable<(string Name, string Text, string Dot, string Detail)> Chips()
    {
        var now = Clock.GetUtcNow();
        foreach (var (name, jobNames) in SourceGroups)
        {
            var jobs = _snapshot.Jobs.Where(j => jobNames.Contains(j.Name)).ToList();
            if (name == "Cortex XDR" && jobs.Count == 0)
            {
                continue; // optional source, not configured: no chip
            }

            if (jobs.Count == 0 || jobs.All(j => j.LastSuccessAt is null))
            {
                yield return (name, "sem coleta", "m", jobs.FirstOrDefault()?.Error ?? "Ainda não coletou.");
                continue;
            }

            var failed = jobs.Where(j => j.Status is "Falhou").ToList();
            var never = jobs.Where(j => j.LastSuccessAt is null).ToList();
            var oldest = jobs.Where(j => j.LastSuccessAt is not null).Min(j => j.LastSuccessAt);
            if (failed.Count > 0)
            {
                yield return (name, "atrasada", "w", string.Join(" | ", failed.Select(j => $"{Fmt.JobLabel(j.Name)}: {j.Error}")));
            }
            else if (never.Count > 0)
            {
                yield return (name, "parcial", "w", "Ainda sem coleta de: " + string.Join(", ", never.Select(j => Fmt.JobLabel(j.Name))));
            }
            else
            {
                yield return (name, Fmt.Ago(oldest, now), "", "Em dia");
            }
        }
    }
}
