@inherits LayoutComponentBase
@inject InventorySnapshotService Inventory
@inject TimeProvider Clock
@inject CurrentAccess Access
@inject EntraStatus Entra

<a class="skip" href="#conteudo">Ir para o conteúdo</a>
<div class="app">
    <aside class="side">
        <a class="brand" href="/painel"><BrandMark Size="34" /><div><b>Azul Nexus</b><span>Saúde e inventário do parque</span></div></a>
        <nav class="nav" aria-label="Principal">
            <h6>Visão geral</h6>
            <NavLink href="/painel" Match="NavLinkMatch.All">Visão executiva</NavLink>
            <h6>Parque ativo</h6>
            <NavLink href="/parque-ativo">Estado dos ativos<i>@_snapshot.Overview().Active</i></NavLink>
            <NavLink href="/comparativo">Comparar fontes</NavLink>
            <h6>Inventário</h6>
            <NavLink href="/inventario" Match="NavLinkMatch.All">Todos os ativos<i>@_snapshot.Views.Count</i></NavLink>
            <a href="/inventario?tipo=notebook,desktop,mac">Computadores<i>@TypeCount(AssetTypes.Notebook, AssetTypes.Desktop, AssetTypes.Mac)</i></a>
            <a href="/inventario?tipo=server">Servidores<i>@TypeCount(AssetTypes.Server)</i></a>
            <a href="/inventario?tipo=phone,tablet">Celulares e tablets<i>@TypeCount(AssetTypes.Phone, AssetTypes.Tablet)</i></a>
            <h6>Governança Microsoft</h6>
            <NavLink href="/governanca" Match="NavLinkMatch.All">Entra, MDM e conformidade</NavLink>
            <NavLink href="/intune">Políticas do Intune<i>@_snapshot.Intune.Policies</i></NavLink>
            <NavLink href="/pendencias">Pendências de gestão<i>@_snapshot.Issues.WithPending</i></NavLink>
            <NavLink href="/governanca/funis">Funis SCCM e Intune</NavLink>
            <h6>MAM e BYOD</h6>
            <NavLink href="/mam" Match="NavLinkMatch.All">Proteção de aplicativos</NavLink>
            <NavLink href="/byod">BYOD<i>@(Count(Groups.ByodMobile) + Count(Groups.ByodComputers))</i></NavLink>
            <h6>Qualidade dos dados</h6>
            <NavLink href="/qualidade">Duplicidades e lacunas<i>@_snapshot.Review.Count</i></NavLink>
            <h6>Operações</h6>
            <NavLink href="/operacao">Fontes e coletas</NavLink>
            <NavLink href="/saude">Saúde do Nexus</NavLink>
            <NavLink href="/assistente">Assistente</NavLink>
            @if (Access.CanAudit){<NavLink href="/auditoria">Trilha de auditoria</NavLink>}
        </nav>
        <div class="sidefoot">Somente leitura. Nenhuma ação é executada nas ferramentas de origem.</div>
    </aside>
    <div class="main">
        <header class="top">
            <form class="search" method="get" action="/inventario" role="search">
                <span aria-hidden="true">⌕</span>
                <input name="q" type="search" placeholder="Buscar por nome, usuário, serial ou modelo" aria-label="Busca global" />
            </form>
            <div class="chips">
                @foreach (var chip in Chips())
                {
                    <a class="src" href="/operacao" title="@chip.Detail"><i class="dot @chip.Dot" aria-hidden="true"></i>@chip.Name · @chip.Text</a>
                }
            </div>
            <div class="who" title="@WhoTitle">@WhoText@if (Access.IsAuthenticated && !Access.IsSetup && Entra.Active){<form method="post" action="/sair"><AntiforgeryToken /><button type="submit">Sair</button></form>}</div>
            <div class="themesw" role="group" aria-label="Tema da interface"><button type="button" data-theme-set="system" aria-pressed="false" title="Seguir o tema do sistema">Sistema</button><button type="button" data-theme-set="light" aria-pressed="false">Claro</button><button type="button" data-theme-set="dark" aria-pressed="false">Escuro</button></div>
        </header>
        <main class="page" id="conteudo" tabindex="-1">
            @Body
        </main>
    </div>
</div>

<div id="blazor-error-ui">
    Ocorreu um erro inesperado. <a href="" class="reload">Recarregar</a>
</div>

@code {
    private InventorySnapshot _snapshot = InventorySnapshot.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _snapshot = await Inventory.GetAsync();
        }
        catch (Exception)
        {
            _snapshot = InventorySnapshot.Empty; // setup screens must still open when the inventory cannot be read
        }
    }

    private int Count(string group) => _snapshot.Issues.Group(group);

    private string WhoText => Access.IsSetup ? "Operador (servidor)" : Access.IsAuthenticated ? Access.Actor : "Acesso aberto · leitura";

    private string WhoTitle => Access.IsAuthenticated ? "Papéis: " + string.Join(", ", NexusRoles.All.Where(Access.Roles.Contains).Select(NexusRoles.Title)) : "Sem login: o inventário é de leitura e dados pessoais de BYOD aparecem mascarados.";

    private int TypeCount(params string[] types) => _snapshot.Views.Count(v => types.Contains(v.Asset.AssetType));

    /// <summary>One chip per source, from the same builder the executive and operations pages use.</summary>
    private IEnumerable<(string Name, string Text, string Dot, string Detail)> Chips()
    {
        var now = Clock.GetUtcNow();
        foreach (var h in SourceHealthBuilder.Build(_snapshot.Jobs, now))
        {
            var dot = h.Status switch { SourceHealth.Ok => "", SourceHealth.Failed => "b", SourceHealth.Late or SourceHealth.Partial => "w", _ => "m" };
            yield return (h.Label, h.Status == SourceHealth.Ok ? Fmt.Ago(h.LastSuccessAt, now) : h.Text, dot, h.Detail);
        }
    }
}
